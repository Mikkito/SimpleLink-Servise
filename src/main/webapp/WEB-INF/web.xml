<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                      http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
  version="4.0">
	<display-name>SimpleLink</display-name>
	<welcome-file-list>
		<welcome-file>GeneralPage.html</welcome-file>
		<welcome-file>GeneralPage.jsp</welcome-file>
	</welcome-file-list>
	<servlet>
		<servlet-name>GeneralPage</servlet-name>
		<jsp-file>/GeneralPage.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>GeneralPage</servlet-name>
		<url-pattern>/SimpleLink</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>Registration</servlet-name>
		<jsp-file>/Registration.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>Registration</servlet-name>
		<url-pattern>/Registration</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>Login</servlet-name>
		<jsp-file>/Login.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>Login</servlet-name>
		<url-pattern>/Login</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>LC</servlet-name>
		<jsp-file>/LC.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>LC</servlet-name>
		<url-pattern>/LC</url-pattern>
	</servlet-mapping>
</web-app>